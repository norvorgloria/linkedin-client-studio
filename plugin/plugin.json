{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "linkedin-client-studio",
  "version": "1.0.0",
  "description": "Evidence-first LinkedIn client workflows with functional MCP tools.",
  "author": {
    "name": "Gloria Norvor",
    "email": "admin@glorianorvor.com"
  },
  "homepage": "https://linkedin-client-studio.onrender.com",
  "keywords": [
    "linkedin",
    "ghostwriting",
    "client-management",
    "content-planning"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "LinkedIn Client Studio",
        "developerName": "Gloria Norvor",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "shortDescription": "LinkedIn client workflows",
        "longDescription": "Evidence-first LinkedIn onboarding, positioning, profile writing, calendars, draft reviews and metrics. No LinkedIn access or automatic publishing.",
        "defaultPrompt": [
          "Build a LinkedIn client brief from these notes.",
          "Plan a LinkedIn content calendar for my client.",
          "Review this LinkedIn post for claims to verify."
        ],
        "logo": "./assets/icon.png",
        "websiteURL": "https://linkedin-client-studio.onrender.com",
        "supportURL": "https://linkedin-client-studio.onrender.com/support",
        "privacyPolicyURL": "https://linkedin-client-studio.onrender.com/privacy",
        "termsOfServiceURL": "https://linkedin-client-studio.onrender.com/terms"
      }
    }
  }
}
